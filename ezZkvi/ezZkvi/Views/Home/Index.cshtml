@{
    ViewData["Title"] = "Platforma za provjeru znanja";
}

@section Styles {
<style>
  :root {
    --bg: #080C14; --surface: #0F1620; --card: #141D2B;
    --border: #1E2D42; --accent: #00E5FF; --amber: #FFB300;
    --text: #E8EDF5; --muted: #5A7090; --success: #00E676; --danger: #FF5252;
    --purple: #BB86FC;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; } 
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg); color: var(--text);
    font-family: 'Nunito Sans', sans-serif;
    overflow-x: hidden;
  }

  /* ===== NAVBAR ===== */
  .navbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 18px 40px; display: flex; align-items: center; justify-content: space-between;
    background: rgba(8,12,20,0.85); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,229,255,0.06);
    transition: all 0.3s;
  }
  .navbar.scrolled { padding: 12px 40px; background: rgba(8,12,20,0.95); border-bottom-color: rgba(0,229,255,0.1); }
  .nav-logo {
    font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase; color: var(--text); text-decoration: none;
  }
  .nav-logo span { color: var(--accent); }
  .nav-right { display: flex; align-items: center; gap: 20px; }
  .nav-status { font-size: 0.78rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .nav-status .dot { width: 6px; height: 6px; background: var(--success); border-radius: 50%; }
  .nav-btn {
    padding: 8px 28px; background: var(--accent); color: var(--bg);
    border-radius: 8px; font-weight: 700; font-family: 'Rajdhani', sans-serif;
    letter-spacing: 2px; text-transform: uppercase; font-size: 0.85rem;
    transition: all 0.3s; text-decoration: none; cursor: pointer; border: none;
  }
  .nav-btn:hover { background: #fff; box-shadow: 0 0 20px rgba(0,229,255,0.4); }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden; padding: 120px 40px 80px;
  }
  .hero-grid {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
  }
  .hero-glow {
    position: absolute; width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(0,229,255,0.08) 0%, transparent 60%);
    top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 0;
    animation: heroPulse 5s ease-in-out infinite;
  }
  @@keyframes heroPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
    50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }
  .particles { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .particle {
    position: absolute; width: 3px; height: 3px; background: var(--accent);
    border-radius: 50%; opacity: 0; animation: particleFloat linear infinite;
  }
  @@keyframes particleFloat {
    0% { opacity: 0; transform: translateY(100vh) scale(0); }
    10% { opacity: 0.5; }
    90% { opacity: 0.5; }
    100% { opacity: 0; transform: translateY(-20vh) scale(1); }
  }

  .hero-content {
    position: relative; z-index: 1; text-align: center; max-width: 750px;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 18px; background: rgba(0,229,255,0.06);
    border: 1px solid rgba(0,229,255,0.15); border-radius: 20px;
    font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 28px;
    animation: fadeUp 0.8s ease both;
  }
  .badge-dot { width: 6px; height: 6px; background: var(--success); border-radius: 50%; animation: blink 2s ease-in-out infinite; }
  @@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero-title {
    font-family: 'Rajdhani', sans-serif; font-size: 4.2rem; font-weight: 700;
    letter-spacing: 4px; text-transform: uppercase; line-height: 1.1;
    margin-bottom: 20px; animation: fadeUp 0.8s ease 0.15s both;
  }
  .hero-title .hl {
    background: linear-gradient(135deg, var(--accent), var(--purple));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-size: 1.05rem; color: var(--muted); line-height: 1.7;
    max-width: 560px; margin: 0 auto 40px;
    animation: fadeUp 0.8s ease 0.3s both;
  }
  .hero-btn {
    display: inline-block; padding: 16px 52px; background: var(--accent); color: var(--bg);
    border: none; border-radius: 10px; cursor: pointer;
    font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase;
    transition: all 0.3s; text-decoration: none;
    animation: fadeUp 0.8s ease 0.45s both;
  }
  .hero-btn:hover {
    background: #fff; box-shadow: 0 0 40px rgba(0,229,255,0.5);
    transform: translateY(-3px);
  }

  .scroll-indicator {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: fadeUp 0.8s ease 0.6s both;
  }
  .scroll-mouse {
    width: 24px; height: 38px; border: 2px solid var(--border); border-radius: 12px;
    display: flex; justify-content: center; padding-top: 6px;
  }
  .scroll-dot {
    width: 3px; height: 8px; background: var(--accent); border-radius: 3px;
    animation: scrollDot 2s ease-in-out infinite;
  }
  @@keyframes scrollDot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(10px); opacity: 0.2; }
  }

  /* ===== FEATURES ===== */
  section { padding: 100px 40px; }
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-badge {
    display: inline-block; padding: 5px 16px; background: rgba(0,229,255,0.06);
    border: 1px solid rgba(0,229,255,0.12); border-radius: 15px;
    font-size: 0.68rem; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px;
  }
  .section-title {
    font-family: 'Rajdhani', sans-serif; font-size: 2.4rem; font-weight: 700;
    letter-spacing: 2px; margin-bottom: 14px;
  }
  .section-title span { color: var(--accent); }
  .section-desc { font-size: 0.95rem; color: var(--muted); max-width: 520px; margin: 0 auto; line-height: 1.7; }

  .features { max-width: 1050px; margin: 0 auto; }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .feature-card {
    background: var(--card); border: 1px solid var(--border); border-radius: 14px;
    padding: 32px; transition: all 0.4s; position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0;
    height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .feature-card:hover { border-color: rgba(0,229,255,0.25); transform: translateY(-5px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; margin-bottom: 18px;
    background: rgba(0,229,255,0.07);
  }
  .feature-card:nth-child(2) .feature-icon { background: rgba(255,179,0,0.07); }
  .feature-card:nth-child(3) .feature-icon { background: rgba(0,230,118,0.07); }
  .feature-card:nth-child(4) .feature-icon { background: rgba(187,134,252,0.07); }
  .feature-card:nth-child(5) .feature-icon { background: rgba(255,82,82,0.07); }
  .feature-card:nth-child(6) .feature-icon { background: rgba(0,229,255,0.07); }
  .feature-name { font-family: 'Rajdhani', sans-serif; font-size: 1.15rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 8px; }
  .feature-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.6; }

  /* ===== STATS ===== */
  .stats-section {
    padding: 60px 40px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .stats-row {
    max-width: 800px; margin: 0 auto;
    display: flex; justify-content: center; gap: 60px; flex-wrap: wrap;
  }
  .stat-item { text-align: center; }
  .stat-num {
    font-family: 'Rajdhani', sans-serif; font-size: 2.4rem; font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--purple));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label { font-size: 0.7rem; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-top: 4px; }

  /* ===== FLOW SECTION ===== */
  .flow { max-width: 700px; margin: 0 auto; }
  .flow-steps { display: flex; flex-direction: column; gap: 0; position: relative; }
  .flow-steps::before {
    content: ''; position: absolute; left: 24px; top: 0; bottom: 0;
    width: 2px; background: var(--border);
  }
  .flow-step {
    display: flex; gap: 20px; align-items: flex-start; padding: 20px 0;
    position: relative;
  }
  .flow-dot {
    width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; background: var(--card); border: 2px solid var(--border); z-index: 1;
    transition: all 0.3s;
  }
  .flow-step:hover .flow-dot { border-color: var(--accent); box-shadow: 0 0 16px rgba(0,229,255,0.15); }
  .flow-text { flex: 1; padding-top: 6px; }
  .flow-title { font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 6px; }
  .flow-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.6; }

  /* ===== CTA ===== */
  .cta-section {
    text-align: center; padding: 100px 40px;
    background: linear-gradient(180deg, var(--bg), var(--surface));
    position: relative; overflow: hidden;
  }
  .cta-section::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  .cta-content { position: relative; z-index: 1; }
  .cta-title {
    font-family: 'Rajdhani', sans-serif; font-size: 2.8rem; font-weight: 700;
    letter-spacing: 3px; margin-bottom: 14px;
  }
  .cta-title span { color: var(--accent); }
  .cta-desc { color: var(--muted); font-size: 1rem; margin-bottom: 36px; }
  .cta-btn {
    display: inline-block; padding: 16px 52px; background: var(--accent); color: var(--bg);
    border: none; border-radius: 10px; cursor: pointer;
    font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase;
    transition: all 0.3s; text-decoration: none;
  }
  .cta-btn:hover {
    background: #fff; box-shadow: 0 0 40px rgba(0,229,255,0.5);
    transform: translateY(-3px);
  }

  /* ===== FOOTER ===== */
  .footer {
    padding: 36px 40px; border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 16px;
  }
  .footer-logo {
    font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700;
    letter-spacing: 3px; color: var(--text);
  }
  .footer-logo span { color: var(--accent); }
  .footer-copy { font-size: 0.72rem; color: var(--muted); margin-top: 4px; }

  /* ===== REVEAL ===== */
  .reveal {
    opacity: 0; transform: translateY(28px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @@keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

  /* ===== RESPONSIVE ===== */
  @@media (max-width: 1024px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @@media (max-width: 768px) {
    .nav-right .nav-status { display: none; }
    .hero { padding: 100px 20px 60px; }
    .hero-title { font-size: 2.4rem; letter-spacing: 2px; }
    .hero-sub { font-size: 0.92rem; }
    section { padding: 60px 20px; }
    .section-title { font-size: 1.8rem; }
    .features-grid { grid-template-columns: 1fr; }
    .stats-row { gap: 30px; }
    .cta-title { font-size: 2rem; }
    .footer { flex-direction: column; text-align: center; }
  }
</style>
}

<!-- NAVBAR -->
<nav class="navbar" id="navbar">
  <a class="nav-logo" href="#">KVIZ<span>APP</span></a>
  <div class="nav-right">
    <div class="nav-status"><span class="dot"></span> Platforma aktivna</div>
    <a class="nav-btn" asp-controller="Account" asp-action="Login">Prijava</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
  <div class="particles" id="particles"></div>

  <div class="hero-content">
    <div class="hero-badge"><span class="badge-dot"></span> ETF · OOAD Projekt 2025–26</div>
    <h1 class="hero-title">Testiraj znanje<br><span class="hl">brzo i efikasno</span></h1>
    <p class="hero-sub">
      Interaktivna platforma za kvizove — priprema, simulacija realnih uslova,
      rang lista i feedback sistem za stalno poboljšanje.
    </p>
    <a class="hero-btn" asp-controller="Account" asp-action="Login">Prijavi se →</a>
  </div>

  <div class="scroll-indicator">
    <div class="scroll-mouse"><div class="scroll-dot"></div></div>
  </div>
</section>

<!-- FEATURES -->
<section id="features">
  <div class="features">
    <div class="section-header reveal">
      <div class="section-badge">Mogućnosti</div>
      <h2 class="section-title">Šta možeš <span>raditi</span></h2>
      <p class="section-desc">Kompletna platforma dizajnirana za efektivno učenje i provjeru znanja.</p>
    </div>

    <div class="features-grid">
      <div class="feature-card reveal">
        <div class="feature-icon">📚</div>
        <div class="feature-name">Priprema za kviz</div>
        <div class="feature-desc">Vježbaj pitanja po predmetima i oblastima bez vremenskog ograničenja, sa objašnjenjima uz svaki odgovor.</div>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">⏱</div>
        <div class="feature-name">Simulacija kviza</div>
        <div class="feature-desc">Pokreni simulaciju pod realnim uslovima — tajmer, bodovanje i detaljan pregled rezultata na kraju.</div>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">🏆</div>
        <div class="feature-name">Rang lista</div>
        <div class="feature-desc">Prati svoju poziciju među kolegama. Filtriraj po predmetima i vremenskom periodu.</div>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">💬</div>
        <div class="feature-name">Feedback</div>
        <div class="feature-desc">Predloži nova pitanja za bazu ili prijavi grešku u sadržaju. Svaki feedback se pregleda i obrađuje.</div>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">📝</div>
        <div class="feature-name">Upravljanje sadržajem</div>
        <div class="feature-desc">Moderatori kreiraju, uređuju i organizuju pitanja po predmetima, oblastima i nivoima težine.</div>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">👑</div>
        <div class="feature-name">Administracija</div>
        <div class="feature-desc">Kompletna kontrola sistema — korisnici, uloge, obavijesti, odobrenje naloga i pregled aktivnosti.</div>
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<div class="stats-section">
  <div class="stats-row">
    <div class="stat-item reveal"><div class="stat-num" data-target="@ViewBag.BrojKorisnika">0</div><div class="stat-label">Korisnika</div></div>
    <div class="stat-item reveal"><div class="stat-num" data-target="@ViewBag.BrojPitanja">0</div><div class="stat-label">Pitanja</div></div>
    <div class="stat-item reveal"><div class="stat-num" data-target="@ViewBag.BrojKvizova">0</div><div class="stat-label">Kvizova</div></div>
    <div class="stat-item reveal"><div class="stat-num" data-target="@ViewBag.BrojPredmeta">0</div><div class="stat-label">Predmeta</div></div>
  </div>
</div>

<!-- FLOW -->
<section id="flow" style="background:var(--surface)">
  <div class="flow">
    <div class="section-header reveal">
      <div class="section-badge">Proces</div>
      <h2 class="section-title">Kako <span>funkcioniše</span></h2>
    </div>

    <div class="flow-steps">
      <div class="flow-step reveal">
        <div class="flow-dot">🔐</div>
        <div class="flow-text">
          <div class="flow-title">Prijavi se na platformu</div>
          <div class="flow-desc">Unesi svoje korisničko ime i lozinku. Ako nemaš nalog, registracija je brza i jednostavna — samo popuni formu i sačekaj odobrenje.</div>
        </div>
      </div>
      <div class="flow-step reveal">
        <div class="flow-dot">📚</div>
        <div class="flow-text">
          <div class="flow-title">Odaberi predmet i vježbaj</div>
          <div class="flow-desc">Izaberi željeni predmet i oblast. U pripremnom modusu vježbaj bez pritiska vremena — svako pitanje ima detaljno objašnjenje.</div>
        </div>
      </div>
      <div class="flow-step reveal">
        <div class="flow-dot">⏱</div>
        <div class="flow-text">
          <div class="flow-title">Pokreni simulaciju</div>
          <div class="flow-desc">Kad si spreman, pokreni simulaciju sa tajmerom. Rezultati i pregled tačnih odgovora te čekaju na kraju.</div>
        </div>
      </div>
      <div class="flow-step reveal">
        <div class="flow-dot">🏆</div>
        <div class="flow-text">
          <div class="flow-title">Prati rang i napreduj</div>
          <div class="flow-desc">Provjeri svoju poziciju na rang listi, analiziraj napredak i pošalji feedback ako imaš prijedlog za nova pitanja.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="cta-content reveal">
    <h2 class="cta-title">Spreman za <span>izazov</span>?</h2>
    <p class="cta-desc">Prijavi se i počni sa učenjem.</p>
    <a class="cta-btn" asp-controller="Account" asp-action="Login">Prijava →</a>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div>
    <div class="footer-logo">KVIZ<span>APP</span></div>
    <div class="footer-copy">© 2025–26 · ETF Sarajevo · OOAD Projekt</div>
  </div>
</footer>

@section Scripts {
<script>
  // Particles
  const pc = document.getElementById('particles');
  for (let i = 0; i < 25; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (7 + Math.random() * 10) + 's';
    p.style.animationDelay = Math.random() * 8 + 's';
    const s = 2 + Math.random() * 3;
    p.style.width = p.style.height = s + 'px';
    pc.appendChild(p);
  }

  // Navbar scroll
  window.addEventListener('scroll', () => {
    document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
  });

  // Reveal on scroll
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 60);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  // Counter
  const cObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target, target = parseInt(el.dataset.target);
        let cur = 0;
        const inc = target / 50;
        const t = setInterval(() => {
          cur += inc;
          if (cur >= target) { el.textContent = target.toLocaleString(); clearInterval(t); }
          else el.textContent = Math.floor(cur).toLocaleString();
        }, 30);
        cObs.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.stat-num[data-target]').forEach(el => cObs.observe(el));
</script>
}