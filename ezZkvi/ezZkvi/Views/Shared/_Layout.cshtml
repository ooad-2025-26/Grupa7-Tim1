<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] – ezZkvi</title>

    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #080C14; --surface: #0F1620; --card: #141D2B;
            --border: #1E2D42; --accent: #00E5FF; --amber: #FFB300;
            --text: #E8EDF5; --muted: #5A7090; --success: #00E676; --danger: #FF5252;
            --purple: #BB86FC; --gold: #FFD700; --silver: #C0C0C0; --bronze: #CD7F32;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Nunito Sans', sans-serif;
            min-height: 100vh;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
