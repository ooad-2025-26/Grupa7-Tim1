@model ezZkvi.ViewModels.SimulacijaKvizaViewModel

@{
    ViewData["Title"] = "Simulacija kviza";

    var imaRezultat = Model.Result != null;
    var imaPitanja = Model.Questions != null && Model.Questions.Any() && !imaRezultat;
    var totalSeconds = Model.VremenskoOgranicenjeMinuta * 60;
}

@section Styles {
    <style>
        :root {
            --bg: #070b12;
            --card: #111a29;
            --card2: #0d1421;
            --border: #21324b;
            --accent: #00e5ff;
            --yellow: #ffcc00;
            --orange: #f59e0b;
            --text: #e8edf5;
            --muted: #6f85a5;
            --success: #00e676;
            --danger: #ff5252;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Nunito Sans', sans-serif;
        }

        .simulation-page {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            padding: 34px 18px 60px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 0 14px;
            margin-bottom: 18px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #0e1726;
            color: var(--muted);
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-decoration: none;
            transition: 0.2s ease;
        }

            .back-btn:hover {
                color: var(--accent);
                border-color: var(--accent);
                background: rgba(0, 229, 255, 0.06);
                text-decoration: none;
            }

        .page-heading {
            margin-bottom: 22px;
        }

        .page-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 2.05rem;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1;
            color: #ffffff;
            margin: 0;
        }

            .page-title span {
                color: var(--accent);
            }

        .page-subtitle {
            margin-top: 8px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .alert-error {
            width: 100%;
            background: rgba(255, 82, 82, 0.08);
            border: 1px solid rgba(255, 82, 82, 0.35);
            color: #ff8a8a;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 0.86rem;
            line-height: 1.45;
            margin-bottom: 18px;
        }

        .simulation-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.28);
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            color: var(--muted);
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

            .section-label::before {
                content: "";
                width: 3px;
                height: 14px;
                border-radius: 2px;
                background: var(--accent);
            }

        .form-description {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.55;
            margin-bottom: 22px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            color: var(--muted);
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .simulation-select {
            width: 100%;
            height: 46px;
            background: #0b1220;
            color: #ffffff;
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 0 13px;
            font-size: 0.92rem;
            font-family: 'Nunito Sans', sans-serif;
            outline: none;
            cursor: pointer;
        }

            .simulation-select:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.12);
            }

        .inline-error {
            display: none;
            margin-top: 8px;
            color: #ff8a8a;
            font-size: 0.82rem;
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .btn-main,
        .btn-secondary {
            min-height: 42px;
            padding: 0 17px;
            border-radius: 9px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.88rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .btn-main {
            background: var(--accent);
            border: 1px solid var(--accent);
            color: #06101a;
        }

            .btn-main:hover {
                background: #7cf3ff;
                border-color: #7cf3ff;
                color: #06101a;
                text-decoration: none;
                transform: translateY(-1px);
            }

        .btn-secondary {
            background: #0e1726;
            border: 1px solid var(--border);
            color: var(--text);
        }

            .btn-secondary:hover {
                border-color: var(--accent);
                color: var(--accent);
                background: rgba(0, 229, 255, 0.06);
                text-decoration: none;
                transform: translateY(-1px);
            }

        .quiz-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .quiz-meta {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .timer-box {
            min-width: 116px;
            padding: 10px 14px;
            border-radius: 11px;
            border: 1px solid rgba(255, 204, 0, 0.35);
            background: rgba(255, 204, 0, 0.08);
            text-align: center;
        }

        .timer-label {
            color: var(--muted);
            font-size: 0.67rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        .timer-value {
            color: var(--yellow);
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.55rem;
            font-weight: 800;
            line-height: 1;
        }

        .question-card {
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 14px;
        }

        .question-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 14px;
        }

        .question-number {
            color: var(--accent);
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .question-text {
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
            line-height: 1.45;
        }

        .difficulty {
            flex-shrink: 0;
            color: var(--orange);
            border: 1px solid rgba(245, 158, 11, 0.35);
            background: rgba(245, 158, 11, 0.08);
            border-radius: 999px;
            padding: 5px 9px;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .answers {
            display: grid;
            gap: 9px;
        }

        .answer-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 13px;
            border-radius: 9px;
            border: 1px solid var(--border);
            background: rgba(7, 11, 18, 0.55);
            color: var(--text);
            cursor: pointer;
            transition: 0.2s ease;
        }

            .answer-option:hover {
                border-color: var(--accent);
                background: rgba(0, 229, 255, 0.05);
            }

            .answer-option input {
                accent-color: var(--accent);
                cursor: pointer;
            }

        .result-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin: 20px 0;
        }

        .result-stat {
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 15px;
        }

        .result-label {
            color: var(--muted);
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .result-value {
            font-family: 'Rajdhani', sans-serif;
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
        }

            .result-value.accent {
                color: var(--accent);
            }

            .result-value.success {
                color: var(--success);
            }

            .result-value.danger {
                color: var(--danger);
            }

        .answers-review {
            margin-top: 26px;
        }

        .review-item {
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .review-question {
            color: #ffffff;
            font-weight: 800;
            line-height: 1.45;
            margin-bottom: 10px;
        }

        .review-line {
            color: var(--muted);
            font-size: 0.88rem;
            margin-top: 5px;
        }

            .review-line strong {
                color: var(--text);
            }

        .review-status {
            display: inline-block;
            margin-top: 11px;
            border-radius: 999px;
            padding: 5px 9px;
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

            .review-status.ok {
                color: var(--success);
                background: rgba(0, 230, 118, 0.08);
                border: 1px solid rgba(0, 230, 118, 0.3);
            }

            .review-status.bad {
                color: var(--danger);
                background: rgba(255, 82, 82, 0.08);
                border: 1px solid rgba(255, 82, 82, 0.3);
            }

        @@media (max-width: 768px) {
            .simulation-page {
                padding: 24px 14px 45px;
            }

            .simulation-card {
                padding: 20px;
            }

            .result-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .actions {
                flex-direction: column;
            }

            .btn-main,
            .btn-secondary {
                width: 100%;
            }
        }

        @@media (max-width: 520px) {
            .result-grid {
                grid-template-columns: 1fr;
            }

            .quiz-top {
                align-items: stretch;
            }

            .timer-box {
                width: 100%;
            }
        }
    </style>
}

<div class="simulation-page">

    <a asp-controller="Student" asp-action="Dashboard" class="back-btn">
        ← Nazad
    </a>

    <div class="page-heading">
        <h1 class="page-title">Simulacija <span>kviza</span></h1>

        <div class="page-subtitle">
            Odaberi predmet i pokreni simulaciju. Pitanja se nasumično uzimaju iz baze.
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert-error">
            @Model.ErrorMessage
        </div>
    }

    @if (imaRezultat)
    {
        <div class="simulation-card">
            <div class="section-label">Rezultat simulacije</div>

            <div class="result-grid">
                <div class="result-stat">
                    <div class="result-label">Rezultat</div>
                    <div class="result-value accent">@Model.Result!.Procenat%</div>
                </div>

                <div class="result-stat">
                    <div class="result-label">Tačno</div>
                    <div class="result-value success">@Model.Result.TacnihOdgovora</div>
                </div>

                <div class="result-stat">
                    <div class="result-label">Netačno</div>
                    <div class="result-value danger">@Model.Result.NetacnihOdgovora</div>
                </div>

                <div class="result-stat">
                    <div class="result-label">Ukupno</div>
                    <div class="result-value">@Model.Result.UkupnoPitanja</div>
                </div>
            </div>

            <div class="actions">
                <a asp-controller="Student" asp-action="Simulate" class="btn-main">
                    Nova simulacija
                </a>

                <a asp-controller="Student" asp-action="Dashboard" class="btn-secondary">
                    Nazad na dashboard
                </a>
            </div>

            <div class="answers-review">
                <div class="section-label">Pregled odgovora</div>

                @foreach (var item in Model.Result.Pregled)
                {
                    <div class="review-item">
                        <div class="review-question">@item.TekstPitanja</div>

                        <div class="review-line">
                            <strong>Tvoj odgovor:</strong>
                            @(item.KorisnickiOdgovor ?? "Nije odgovoreno")
                        </div>

                        <div class="review-line">
                            <strong>Tačan odgovor:</strong>
                            @item.TacanOdgovor
                        </div>

                        @if (item.JeTacno)
                        {
                            <span class="review-status ok">Tačno</span>
                        }
                        else
                        {
                            <span class="review-status bad">Netačno</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (imaPitanja)
    {
        <div class="simulation-card">
            <div class="quiz-top">
                <div>
                    <div class="section-label">Aktivna simulacija</div>
                    <div class="quiz-meta">
                        Predmet: @Model.PredmetNaziv<br />
                        Broj pitanja: @Model.BrojPitanja
                    </div>
                </div>

                <div class="timer-box">
                    <div class="timer-label">Vrijeme</div>
                    <div class="timer-value" id="timer" data-seconds="@totalSeconds">15:00</div>
                </div>
            </div>

            <form asp-controller="Student" asp-action="SubmitSimulation" method="post" id="quizForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="PredmetId" value="@Model.PredmetId" />
                <input type="hidden" name="StartedAtUtcTicks" value="@Model.StartedAtUtcTicks" />
                <input type="hidden" name="TotalSeconds" value="@totalSeconds" />

                @for (var i = 0; i < Model.Questions.Count; i++)
                {
                    var pitanje = Model.Questions[i];

                    <div class="question-card">
                        <input type="hidden" name="@($"Odgovori[{i}].PitanjeId")" value="@pitanje.Id" />

                        <div class="question-header">
                            <div>
                                <div class="question-number">Pitanje @(i + 1)</div>
                                <div class="question-text">@pitanje.TekstPitanja</div>
                            </div>

                            <div class="difficulty">@pitanje.Tezina</div>
                        </div>

                        <div class="answers">
                            @for (var j = 0; j < pitanje.Odgovori.Count; j++)
                            {
                                var odgovor = pitanje.Odgovori[j];
                                var radioId = $"q{i}_a{j}";

                                <label class="answer-option" for="@radioId">
                                    <input type="radio"
                                           id="@radioId"
                                           name="@($"Odgovori[{i}].OdgovorId")"
                                           value="@odgovor.Id" />

                                    <span>@odgovor.Tekst</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="actions">
                    <a asp-controller="Student" asp-action="Simulate" class="btn-secondary">
                        Prekini simulaciju
                    </a>

                    <button type="submit" class="btn-main">
                        Završi simulaciju
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="simulation-card">
            <div class="section-label">Pokretanje simulacije</div>

            <p class="form-description">
                Odaberi predmet. Sistem će iz baze nasumično izvući pitanja za odabrani predmet.
            </p>

            <form asp-controller="Student" asp-action="StartSimulation" method="post" id="startSimulationForm">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="PredmetId" class="form-label">Predmet</label>

                    <select asp-for="PredmetId"
                            asp-items="Model.Predmeti"
                            class="simulation-select"
                            id="predmetSelect">
                        <option value="">-- Odaberi predmet --</option>
                    </select>

                    <div class="inline-error" id="predmetError">
                        Moraš odabrati predmet prije pokretanja simulacije.
                    </div>
                </div>

                <div class="actions">
                    <a asp-controller="Student" asp-action="Dashboard" class="btn-secondary">
                        Nazad na dashboard
                    </a>

                    <button type="submit" class="btn-main">
                        Pokreni simulaciju
                    </button>
                </div>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        const startForm = document.getElementById('startSimulationForm');

        if (startForm) {
            startForm.addEventListener('submit', function (event) {
                const predmetSelect = document.getElementById('predmetSelect');
                const predmetError = document.getElementById('predmetError');

                if (!predmetSelect.value) {
                    event.preventDefault();
                    predmetError.style.display = 'block';
                    predmetSelect.focus();
                } else {
                    predmetError.style.display = 'none';
                }
            });
        }

        const timer = document.getElementById('timer');
        const quizForm = document.getElementById('quizForm');

        if (timer && quizForm) {
            let remaining = parseInt(timer.dataset.seconds || '900');

            function renderTimer() {
                const minutes = Math.floor(remaining / 60);
                const seconds = remaining % 60;

                timer.textContent =
                    minutes.toString().padStart(2, '0') + ':' +
                    seconds.toString().padStart(2, '0');
            }

            renderTimer();

            const interval = setInterval(function () {
                remaining--;

                if (remaining <= 0) {
                    clearInterval(interval);
                    quizForm.submit();
                    return;
                }

                renderTimer();
            }, 1000);
        }
    </script>
}