@model ezZkvi.ViewModels.SimulacijaKvizaViewModel

@{
    ViewData["Title"] = "Simulacija kviza";
}

@section Styles {
    <style>
        body {
            background-color: #070b12;
            color: #ffffff;
        }

        .simulation-page {
            min-height: calc(100vh - 100px);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 45px;
        }

        .simulation-card {
            width: 100%;
            max-width: 560px;
            background-color: #111c2e;
            border: 1px solid #263b5c;
            border-radius: 10px;
            padding: 26px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
        }

        .simulation-title {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .simulation-description {
            font-size: 14px;
            color: #9db7d7;
            margin-bottom: 22px;
        }

        .simulation-label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #dbeafe;
        }

        .simulation-select {
            width: 100%;
            height: 44px;
            background-color: #08111f;
            color: #ffffff;
            border: 1px solid #2c4568;
            border-radius: 7px;
            padding: 0 12px;
            font-weight: 600;
            outline: none;
            cursor: pointer;
        }

            .simulation-select:focus {
                border-color: #22d3ee;
                box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.18);
            }

        .validation-message {
            display: block;
            margin-top: 8px;
            font-size: 13px;
            color: #ff6b6b;
        }

        .simulation-actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .btn-start-simulation {
            flex: 1;
            height: 44px;
            border: none;
            border-radius: 7px;
            background-color: #22d3ee;
            color: #020617;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            position: relative;
            z-index: 5;
            transition: 0.15s ease-in-out;
        }

            .btn-start-simulation:hover {
                background-color: #67e8f9;
                color: #020617;
            }

            .btn-start-simulation:active {
                transform: translateY(1px);
            }

        .btn-back-dashboard {
            flex: 1;
            height: 44px;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid #2c4568;
            border-radius: 7px;
            background-color: transparent;
            color: #dbeafe;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: 0.15s ease-in-out;
        }

            .btn-back-dashboard:hover {
                background-color: #17263d;
                color: #ffffff;
                text-decoration: none;
            }

            .btn-back-dashboard:active {
                transform: translateY(1px);
            }

        form {
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 576px) {
            .simulation-page {
                padding: 25px 14px;
            }

            .simulation-card {
                padding: 20px;
            }

            .simulation-actions {
                flex-direction: column;
            }
        }
    </style>
}

<div class="simulation-page">
    <div class="simulation-card">
        <h2 class="simulation-title">Simulacija kviza</h2>

        <p class="simulation-description">
            Odaberi predmet. Sistem će iz baze nasumično uzeti pitanja za simulaciju.
        </p>

        <form asp-controller="Student" asp-action="SubmitSimulation" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="PredmetId" class="simulation-label">Predmet</label>

            <select asp-for="PredmetId"
                    asp-items="Model.Predmeti"
                    class="simulation-select">
                <option value="">-- Odaberi predmet --</option>
            </select>

            <span asp-validation-for="PredmetId" class="validation-message"></span>

            <div class="simulation-actions">
                <a asp-controller="Student"
                   asp-action="Dashboard"
                   class="btn-back-dashboard">
                    Nazad na dashboard
                </a>

                <button type="submit" class="btn-start-simulation">
                    Pokreni simulaciju →
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}