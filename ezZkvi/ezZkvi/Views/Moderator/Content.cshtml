@model IEnumerable<ezZkvi.Models.Pitanje>
@using ezZkvi.Models

@{
    ViewData["Title"] = "Upravljanje sadržajem";

    var roleText = User.IsInRole("Admin") ? "Admin" : "Moderator";
    var backController = User.IsInRole("Admin") ? "Administrator" : "Moderator";
    var selectedTezina = ViewData["Tezina"]?.ToString();
}

@section Styles {
    <style>
        :root {
            --bg: #080C14;
            --surface: #0F1620;
            --card: #141D2B;
            --border: #1E2D42;
            --accent: #00E5FF;
            --amber: #FFB300;
            --text: #E8EDF5;
            --muted: #5A7090;
            --success: #00E676;
            --danger: #FF5252;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Nunito Sans',sans-serif;
            min-height: 100vh;
            padding: 28px 24px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-title {
            font-family: 'Rajdhani',sans-serif;
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

            .page-title span {
                color: var(--accent);
            }

        .role-badge {
            padding: 5px 14px;
            background: rgba(0,229,255,0.1);
            border: 1px solid rgba(0,229,255,0.3);
            border-radius: 20px;
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
        }

        .back-link {
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .back-link:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .tabs {
            display: flex;
            gap: 4px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 4px;
            margin-bottom: 24px;
            width: fit-content;
        }

        .tab {
            padding: 9px 22px;
            border-radius: 7px;
            cursor: pointer;
            font-family: 'Rajdhani',sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--muted);
            transition: all 0.2s;
            border: none;
            background: transparent;
        }

            .tab.active {
                background: var(--accent);
                color: var(--bg);
            }

        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

            .search-wrap input {
                width: 100%;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 14px 10px 36px;
                color: var(--text);
                font-family: 'Nunito Sans',sans-serif;
                font-size: 0.88rem;
                outline: none;
            }

                .search-wrap input:focus {
                    border-color: var(--accent);
                }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 0.9rem;
        }

        select {
            padding: 9px 14px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            font-family: 'Nunito Sans',sans-serif;
        }

            select:focus {
                border-color: var(--accent);
            }

        .btn-add {
            padding: 9px 20px;
            background: var(--accent);
            color: var(--bg);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Rajdhani',sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

            .btn-add:hover {
                background: #fff;
                box-shadow: 0 0 16px rgba(0,229,255,0.4);
                color: var(--bg);
            }

        .table-wrap {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .t-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 220px 100px 120px;
            padding: 12px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
        }

        .t-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 220px 100px 120px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            align-items: center;
            transition: background 0.2s;
        }

            .t-row:last-child {
                border-bottom: none;
            }

            .t-row:hover {
                background: rgba(0,229,255,0.03);
            }

        .q-text-cell {
            font-size: 0.88rem;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding-right: 12px;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            max-width: 190px;
            padding: 4px 10px;
            border-radius: 10px;
            font-size: 0.68rem;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            background: rgba(0,229,255,0.1);
            color: var(--accent);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .diff {
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .diff-easy {
            color: var(--success);
        }

        .diff-med {
            color: var(--amber);
        }

        .diff-hard {
            color: var(--danger);
        }

        .actions-cell {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: flex-start;
        }

        .act-btn {
            min-width: 52px;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.74rem;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            transition: all 0.2s;
            text-decoration: none;
            font-family: 'Nunito Sans',sans-serif;
            text-align: center;
        }

            .act-btn.edit:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .act-btn.del:hover {
                border-color: var(--danger);
                color: var(--danger);
            }

        .panel {
            display: none;
        }

            .panel.active {
                display: block;
            }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.72);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 30px;
            width: 100%;
            max-width: 560px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 70px rgba(0,0,0,0.45);
            animation: fadeUp 0.25s ease both;
        }

        .modal-title {
            font-family: 'Rajdhani',sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--muted);
            font-size: 1.5rem;
            cursor: pointer;
        }

            .modal-close:hover {
                color: var(--danger);
            }

        .form-group {
            margin-bottom: 16px;
        }

            .form-group label {
                display: block;
                font-size: 0.72rem;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: var(--muted);
                margin-bottom: 6px;
            }

        .form-control-dark {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 14px;
            color: var(--text);
            font-family: 'Nunito Sans',sans-serif;
            font-size: 0.88rem;
            outline: none;
        }

            .form-control-dark:focus {
                border-color: var(--accent);
            }

        textarea.form-control-dark {
            min-height: 90px;
            resize: vertical;
        }

        .answers-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .answer-box {
            position: relative;
        }

            .answer-box span {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-family: 'Rajdhani',sans-serif;
                font-weight: 700;
                color: var(--muted);
            }

            .answer-box input {
                padding-left: 36px;
            }

        .modal-two-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        .btn-cancel {
            padding: 10px 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            cursor: pointer;
            font-family: 'Rajdhani',sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .btn-save {
            padding: 10px 24px;
            background: var(--accent);
            color: var(--bg);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Rajdhani',sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

            .btn-save:hover {
                background: #fff;
            }

        .toast {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 200;
            padding: 12px 24px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            transform: translateX(120%);
            transition: transform 0.4s ease;
        }

            .toast.show {
                transform: translateX(0);
            }

            .toast.success {
                background: rgba(0,230,118,0.15);
                border: 1px solid var(--success);
                color: var(--success);
            }

            .toast.error {
                background: rgba(255,82,82,0.15);
                border: 1px solid var(--danger);
                color: var(--danger);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media(max-width:768px) {
            body {
                padding: 16px;
            }

            .t-header,
            .t-row {
                grid-template-columns: 1fr 90px 100px;
            }

                .t-header > :nth-child(3),
                .t-row > :nth-child(3) {
                    display: none;
                }

            .answers-grid,
            .modal-two-cols {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
        <a class="back-link" asp-controller="@backController" asp-action="Dashboard">← Nazad</a>

        <div>
            <div class="page-title">Upravljanje <span>sadržajem</span></div>
            <div style="font-size:0.8rem;color:var(--muted);margin-top:2px;">
                Pitanja i predmeti platforme
            </div>
        </div>
    </div>

    <div class="role-badge">@roleText</div>
</div>

<div class="tabs">
    <button type="button" class="tab active" onclick="switchTab('questions')">Pitanja</button>
    <button type="button" class="tab" onclick="switchTab('subjects')">Predmeti</button>
</div>

<div class="panel active" id="questions">
    <form asp-controller="Moderator" asp-action="Content" method="get" class="toolbar" id="filterForm">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input type="text" name="search" value="@ViewData["Search"]" placeholder="Pretraži pitanja...">
        </div>

        <select name="predmetId" asp-items="ViewBag.Predmeti" onchange="document.getElementById('filterForm').submit()">
            <option value="">Svi predmeti</option>
        </select>

        <select name="tezina" id="tezinaFilter" data-selected="@selectedTezina" onchange="document.getElementById('filterForm').submit()">
            <option value="">Sve težine</option>
            <option value="LAKO">Lako</option>
            <option value="SREDNJE">Srednje</option>
            <option value="TESKO">Teško</option>
        </select>

        <button type="button" class="btn-add" onclick="openQuestionModal()">
            + Dodaj pitanje
        </button>

        <button type="button" class="btn-add" style="background:var(--surface);color:var(--accent);border:1px solid var(--accent)" onclick="openCsvModal()">
            ⇄ CSV
        </button>
    </form>

    <div class="table-wrap" id="questionTable">
        <div class="t-header">
            <span>Pitanje</span>
            <span>Predmet</span>
            <span>Težina</span>
            <span>Akcije</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="t-row" style="grid-template-columns:1fr;">
                <div class="q-text-cell">Nema pitanja u bazi.</div>
            </div>
        }
        else
        {
            @foreach (var pitanje in Model)
            {
                var tezinaClass = pitanje.Tezina == Tezina.LAKO
                ? "diff-easy"
                : pitanje.Tezina == Tezina.SREDNJE
                ? "diff-med"
                : "diff-hard";

                <div class="t-row">
                    <div>
                        <div class="q-text-cell">@pitanje.TekstPitanja</div>
                    </div>

                    <span>
                        <span class="tag">
                            @(pitanje.Predmet != null ? pitanje.Predmet.Naziv : "Bez predmeta")
                        </span>
                    </span>

                    <span class="diff @tezinaClass">
                        @pitanje.Tezina
                    </span>

                    <div class="actions-cell">
                        <a class="act-btn edit"
                           asp-controller="Pitanje"
                           asp-action="Edit"
                           asp-route-id="@pitanje.Id">
                            Uredi
                        </a>

                        <form asp-controller="Pitanje"
                              asp-action="Delete"
                              asp-route-id="@pitanje.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Da li ste sigurni da želite obrisati ovo pitanje?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act-btn del">Obriši</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="panel" id="subjects">
    <div class="toolbar">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input type="text" placeholder="Pretraži predmete...">
        </div>

        <button type="button" class="btn-add" onclick="openSubjectModal()">
            + Novi predmet
        </button>
    </div>

    <div class="table-wrap">
        <div class="t-header" style="grid-template-columns:1fr 90px 140px">
            <span>Naziv predmeta</span>
            <span>Pitanja</span>
            <span>Akcije</span>
        </div>

        @if (ViewBag.PredmetiLista == null || ViewBag.PredmetiLista.Count == 0)
        {
            <div class="t-row" style="grid-template-columns:1fr;">
                <div class="q-text-cell">Nema predmeta. Dodaj prvi predmet dugmetom "+ Novi predmet".</div>
            </div>
        }
        else
        {
            @foreach (var p in ViewBag.PredmetiLista)
            {
                <div class="t-row" style="grid-template-columns:1fr 90px 140px">
                    <div>
                        <div class="q-text-cell">@p.Naziv</div>
                    </div>
                    <span style="font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--accent)">@p.BrojPitanja</span>
                    <div class="actions-cell">
                        <button type="button" class="act-btn edit" data-id="@p.Id" data-naziv="@p.Naziv" onclick="openEditSubject(this)">Uredi</button>
                        <form asp-controller="Predmet" asp-action="DeleteFromContent" asp-route-id="@p.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Obrisati ovaj predmet? (moguće samo ako nema pitanja)');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act-btn del">Obriši</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="modal-overlay" id="questionModal">
    <div class="modal">
        <div class="modal-title">
            Novo pitanje
            <button type="button" class="modal-close" onclick="closeQuestionModal()">×</button>
        </div>

        <form asp-controller="Pitanje" asp-action="CreateFromContent" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Predmet</label>
                <select name="PredmetId" class="form-control-dark" asp-items="ViewBag.Predmeti" required>
                    <option value="">Odaberi predmet</option>
                </select>
            </div>

            <div class="form-group">
                <label>Tekst pitanja</label>
                <textarea name="TekstPitanja" class="form-control-dark" placeholder="Unesite tekst pitanja..." required></textarea>
            </div>

            <div class="form-group">
                <label>Ponuđeni odgovori</label>

                <div class="answers-grid">
                    <div class="answer-box">
                        <span>A</span>
                        <input name="Odgovor1" class="form-control-dark" placeholder="Odgovor A" required />
                    </div>

                    <div class="answer-box">
                        <span>B</span>
                        <input name="Odgovor2" class="form-control-dark" placeholder="Odgovor B" required />
                    </div>

                    <div class="answer-box">
                        <span>C</span>
                        <input name="Odgovor3" class="form-control-dark" placeholder="Odgovor C" required />
                    </div>

                    <div class="answer-box">
                        <span>D</span>
                        <input name="Odgovor4" class="form-control-dark" placeholder="Odgovor D" required />
                    </div>
                </div>
            </div>

            <div class="modal-two-cols">
                <div class="form-group">
                    <label>Tačan odgovor</label>
                    <select name="TacanOdgovor" class="form-control-dark" required>
                        <option value="1">A</option>
                        <option value="2">B</option>
                        <option value="3">C</option>
                        <option value="4">D</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Težina</label>
                    <select name="Tezina" class="form-control-dark" required>
                        <option value="LAKO">Lako</option>
                        <option value="SREDNJE">Srednje</option>
                        <option value="TESKO">Teško</option>
                    </select>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeQuestionModal()">Otkaži</button>
                <button type="submit" class="btn-save">Sačuvaj pitanje</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="subjectModal">
    <div class="modal">
        <div class="modal-title">
            Novi predmet
            <button type="button" class="modal-close" onclick="closeSubjectModal()">×</button>
        </div>

        <form asp-controller="Predmet" asp-action="CreateFromContent" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Naziv predmeta</label>
                <input name="Naziv" class="form-control-dark" placeholder="npr. Operativni sistemi" required />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeSubjectModal()">Otkaži</button>
                <button type="submit" class="btn-save">Sačuvaj predmet</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="subjectEditModal">
    <div class="modal">
        <div class="modal-title">
            Uredi predmet
            <button type="button" class="modal-close" onclick="closeEditSubject()">×</button>
        </div>

        <form asp-controller="Predmet" asp-action="EditFromContent" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editSubjectId" />

            <div class="form-group">
                <label>Naziv predmeta</label>
                <input name="Naziv" id="editSubjectNaziv" class="form-control-dark" required />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeEditSubject()">Otkaži</button>
                <button type="submit" class="btn-save">Sačuvaj izmjene</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="csvModal">
    <div class="modal">
        <div class="modal-title">
            CSV uvoz / izvoz
            <button type="button" class="modal-close" onclick="closeCsvModal()">×</button>
        </div>

        <p style="font-size:0.82rem;color:var(--muted);margin-bottom:18px;line-height:1.5;">
            Preuzmi CSV predmeta, dopuni ga pitanjima (jedan red = jedno pitanje), pa ga uvezi nazad.
            Kolone: <strong>TekstPitanja, OdgovorA, OdgovorB, OdgovorC, OdgovorD, Tacan (A/B/C/D), Tezina (LAKO/SREDNJE/TESKO)</strong>.
        </p>

        <form asp-controller="Predmet" asp-action="ExportCsv" method="get" style="margin-bottom:22px;">
            <div class="form-group">
                <label>Preuzmi pitanja predmeta</label>
                <select name="id" class="form-control-dark" asp-items="ViewBag.Predmeti" required>
                    <option value="">Odaberi predmet</option>
                </select>
            </div>
            <button type="submit" class="btn-save" style="width:100%;">⬇ Preuzmi CSV</button>
        </form>

        <div style="height:1px;background:var(--border);margin:6px 0 18px;"></div>

        <form asp-controller="Predmet" asp-action="ImportCsv" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Uvezi pitanja u predmet</label>
                <select name="predmetId" class="form-control-dark" asp-items="ViewBag.Predmeti" required>
                    <option value="">Odaberi predmet</option>
                </select>
            </div>

            <div class="form-group">
                <label>CSV fajl</label>
                <input type="file" name="file" accept=".csv" class="form-control-dark" required />
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeCsvModal()">Otkaži</button>
                <button type="submit" class="btn-save">⬆ Uvezi CSV</button>
            </div>
        </form>
    </div>
</div>

<div class="toast"
     id="toast"
     data-success="@TempData["Success"]"
     data-error="@TempData["Error"]">
</div>

@section Scripts {
    <script>
        function switchTab(t) {
            document.querySelectorAll('.tab').forEach(function (el, i) {
                el.classList.toggle('active', (i === 0 && t === 'questions') || (i === 1 && t === 'subjects'));
            });

            document.querySelectorAll('.panel').forEach(function (el) {
                el.classList.remove('active');
            });

            document.getElementById(t).classList.add('active');
        }

        function openQuestionModal() {
            document.getElementById('questionModal').classList.add('open');
        }

        function closeQuestionModal() {
            document.getElementById('questionModal').classList.remove('open');
        }

        function openCsvModal() {
            document.getElementById('csvModal').classList.add('open');
        }

        function closeCsvModal() {
            document.getElementById('csvModal').classList.remove('open');
        }

        document.getElementById('csvModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeCsvModal();
            }
        });

        document.getElementById('questionModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeQuestionModal();
            }
        });

        function openSubjectModal() {
            document.getElementById('subjectModal').classList.add('open');
        }

        function closeSubjectModal() {
            document.getElementById('subjectModal').classList.remove('open');
        }

        function openEditSubject(btn) {
            document.getElementById('editSubjectId').value = btn.getAttribute('data-id');
            document.getElementById('editSubjectNaziv').value = btn.getAttribute('data-naziv');
            document.getElementById('subjectEditModal').classList.add('open');
        }

        function closeEditSubject() {
            document.getElementById('subjectEditModal').classList.remove('open');
        }

        document.getElementById('subjectEditModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeEditSubject();
            }
        });

        document.getElementById('subjectModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeSubjectModal();
            }
        });

        function showToast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast ' + type;

            setTimeout(function () {
                t.classList.add('show');
            }, 10);

            setTimeout(function () {
                t.classList.remove('show');
            }, 3500);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const tezinaFilter = document.getElementById('tezinaFilter');
            const selectedTezina = tezinaFilter.getAttribute('data-selected');

            if (selectedTezina) {
                tezinaFilter.value = selectedTezina;
            }

            const toast = document.getElementById('toast');
            const success = toast.getAttribute('data-success');
            const error = toast.getAttribute('data-error');

            if (success) {
                showToast(success, 'success');
            }

            if (error) {
                showToast(error, 'error');
            }
        });
    </script>
}